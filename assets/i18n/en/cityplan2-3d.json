 "if (uNY > 0.5) diffuseColor.rgb *= mix(1.0, 0.42, uNyNight); /* нощем — тъмни стени (тъмносиньо/въглен), не сива „облачна“ фасада */": "",
 "#ifdef USE_EMISSIVEMAP if (uNY > 0.5) { float nearK = 1.0 - smoothstep(120.0, 450.0, vNyD); // отблизо — прозорците по-едри (макс. от 4 съседни точки, ~1 тексел встрани) и по-ярки if (nearK > 0.01) { vec2 ts = 1.1 / vec2(textureSize(emissiveMap, 0)); vec3 m = totalEmissiveRadiance; m = max(m, emissive * texture2D(emissiveMap, vEmissiveMapUv + vec2(ts.x, 0.0)).rgb); m = max(m, emissive * texture2D(emissiveMap, vEmissiveMapUv - vec2(ts.x, 0.0)).rgb); m = max(m, emissive * texture2D(emissiveMap, vEmissiveMapUv + vec2(0.0, ts.y)).rgb); m = max(m, emissive * texture2D(emissiveMap, vEmissiveMapUv - vec2(0.0, ts.y)).rgb); totalEmissiveRadiance = mix(totalEmissiveRadiance, m, nearK); } float lum = dot(totalEmissiveRadiance, vec3(0.333)), base = max(emissive.r, 1e-4), k = lum / base; // 0…1 — яркостта на петното (за прозореца е постоянна) float bld = fract(sin(vNyId * 12.9898 + 1.7) * 43758.5453), dens = bld < 0.22 ? 0.12 : 0.35 + 0.65 * bld; float keep = step(fract(k * 7.0 + bld * 3.1), 0.42 + 0.22 * bld); // ~25–45 % от светналите остават {0} float cool = step(0.86, fract(k * 13.0 + bld)); float amb = fract(k * 11.0 + bld * 5.3); vec3 warm = amb < 0.4 ? vec3(1.0, 0.5, 0.17) : vec3(1.0, 0.7, 0.32); vec3 col = mix(warm, vec3(0.82, 0.9, 1.0), cool) * base * k * keep * dens * {1}; // наситено топло (ACES избелва яркото) float far = smoothstep(350.0, 1100.0, vNyD); // отдалеч — същите точки, по-ярки (мипмапите ги размиват), без равна сива пелена totalEmissiveRadiance = col * (1.0 + 0.9 * far + 0.45 * nearK); } #endif": "",
